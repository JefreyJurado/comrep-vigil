# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# raw source material (copyrighted PDF/images, personal photos) — not read
# by the app at runtime, kept local only
/source-assets

# local Claude Code tooling config
/.claude

# release signing keystore + passwords — NEVER commit, back up separately
/keystore

# built release artifacts (.aab/.apk) — large binaries, don't belong in git
/releases

# copyrighted reference PDF (ICEL/USCCB, "no reproduction without written
# permission") — keep locally for reference only, never commit
/store-listing/THE ROMAN MISSAL-bookmarked.pdf

